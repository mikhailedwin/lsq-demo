{
  "name": "qav",
  "private": true,
  "version": "0.1.0",
  "description": "QAV — real-time conversational AI avatars over WebRTC (self-hosted Anam-style stack)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/* --filter ./apps/* build",
    "typecheck": "pnpm -r --filter ./packages/* --filter ./apps/* typecheck",
    "dev:api": "pnpm --filter @qav/api dev",
    "dev:web": "pnpm --filter @qav/web dev",
    "dev:sdk": "pnpm --filter @qav/js-sdk dev",
    "livekit": "docker compose up livekit"
  }
}
