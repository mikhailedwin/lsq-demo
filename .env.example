# ---------------------------------------------------------------------------
# QAV — copy to .env and fill in. Every service reads this same file.
# ---------------------------------------------------------------------------

# --- LiveKit (WebRTC SFU) ---------------------------------------------------
# Dev-mode livekit-server (docker compose up livekit) uses these fixed creds.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- QAV control plane (apps/api) -------------------------------------------
QAV_API_PORT=8787
# Public URL browsers use to reach the API (embedded in session tokens).
QAV_API_URL=http://localhost:8787
# Server-to-server key. Your backend sends it as `Authorization: Bearer ...`
# to mint session tokens. Never ship it to a browser.
QAV_API_KEY=qav_dev_key_change_me
# Signs short-lived session tokens (HS256).
QAV_SESSION_SECRET=qav_dev_session_secret_change_me
# Persist personas/sessions between restarts (optional).
QAV_DATA_FILE=.data/qav.json

# --- QAV engine (services/engine) -------------------------------------------
# Pipeline providers. Set any of these to `mock` to run without that vendor
# (mock TTS speaks a tone envelope, mock LLM echoes; no STT in mock mode).
QAV_STT=deepgram          # deepgram | openai | mock
QAV_LLM=anthropic         # anthropic | openai | mock
QAV_TTS=elevenlabs        # elevenlabs | cartesia | openai | mock
QAV_LLM_MODEL=claude-opus-5

ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ELEVEN_API_KEY=
CARTESIA_API_KEY=
OPENAI_API_KEY=

# Face renderer: procedural (CPU, built in). Add your own under
# services/engine/qav_engine/avatar/renderers and register it.
QAV_RENDERER=procedural
QAV_VIDEO_WIDTH=512
QAV_VIDEO_HEIGHT=512
QAV_VIDEO_FPS=25

# --- Demo web app (apps/web) -------------------------------------------------
# Server-side only; the Next.js route handler uses it to call the QAV API.
NEXT_PUBLIC_QAV_API_URL=http://localhost:8787
