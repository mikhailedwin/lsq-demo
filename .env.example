# ---------------------------------------------------------------------------
# QAV — copy to .env and fill in. Every service reads this same file.
# ---------------------------------------------------------------------------

# --- LiveKit (WebRTC SFU) ---------------------------------------------------
# Dev-mode livekit-server (docker compose up livekit) uses these fixed creds.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- QAV control plane (apps/api) -------------------------------------------
QAV_API_PORT=8787
# Public URL browsers use to reach the API (embedded in session tokens).
QAV_API_URL=http://localhost:8787
# Server-to-server key. Your backend sends it as `Authorization: Bearer ...`
# to mint session tokens. Never ship it to a browser.
QAV_API_KEY=qav_dev_key_change_me
# Signs short-lived session tokens (HS256).
QAV_SESSION_SECRET=qav_dev_session_secret_change_me
# Persist personas/sessions between restarts (optional).
QAV_DATA_FILE=.data/qav.json

# --- Conversation engine (services/engine) ----------------------------------
# Pipeline providers. Set any of these to `mock` to run without that vendor
# (mock TTS speaks a tone envelope, mock LLM echoes; no STT in mock mode).
QAV_STT=deepgram          # deepgram | openai | mock
QAV_LLM=anthropic         # anthropic | openai | mock
QAV_TTS=elevenlabs        # elevenlabs | cartesia | openai | mock
QAV_LLM_MODEL=claude-opus-5

ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ELEVEN_API_KEY=
CARTESIA_API_KEY=
OPENAI_API_KEY=

# --- Face renderer (services/face) ------------------------------------------
# Default face model for avatars whose catalog entry doesn't name one:
#   procedural — CPU placeholder, runs inside the engine, no GPU needed
#   musetalk   — photoreal lip-sync on a real clip; NVIDIA GPU >= 12 GB
#   liveavatar — generative diffusion face; NVIDIA GPU 80 GB (48 GB with FP8)
QAV_RENDERER=procedural
# auto  — CPU renderers run in the engine, GPU renderers dispatch `qav-face`
# local — force in-process (GPU renderers still dispatch, with a warning)
# remote— always dispatch the face worker
QAV_FACE_MODE=auto
QAV_VIDEO_WIDTH=512
QAV_VIDEO_HEIGHT=512
QAV_VIDEO_FPS=25
# Where prepared avatars live (MuseTalk clips, Live Avatar reference images).
QAV_AVATAR_DIR=avatars
# LiveKit stops dispatching to a worker above this host CPU load (prod 0.7).
# Raise it when LiveKit, the API and the workers share a small dev box.
# QAV_WORKER_LOAD_THRESHOLD=0.95

# Face quality pipeline (see services/face/README.md)
# GFPGAN sharpening of the generated mouth. `auto` enables it only if it fits
# the frame budget on this GPU; `1` forces it on, `0` off.
QAV_FACE_RESTORE=auto
# How much of the restored crop to mix back (1.0 = fully restored, can look waxy).
QAV_FACE_RESTORE_BLEND=0.75
# Adaptive de-flicker strength, 0-1. 0 disables it.
QAV_FACE_SMOOTH=0.6

# MuseTalk (set by the Docker image; only needed for a bare-metal install)
# MUSETALK_ROOT=/opt/musetalk
# MUSETALK_MODELS=/opt/musetalk/models
# QAV_GFPGAN_WEIGHTS=/models/gfpgan/GFPGANv1.4.pth
# QAV_MUSETALK_BATCH=8          # frames per inference batch (latency vs throughput)

# Live Avatar (set by the Docker image; only needed for a bare-metal install)
# LIVEAVATAR_ROOT=/opt/liveavatar
# LIVEAVATAR_CKPT=/ckpt/Wan2.2-S2V-14B
# LIVEAVATAR_LORA=/ckpt/LiveAvatar
# QAV_LIVEAVATAR_SIZE=704*384
# QAV_LIVEAVATAR_FP8=1          # fit in 48 GB, slight quality loss
# QAV_LIVEAVATAR_COMPILE=1      # slow first run, much faster afterwards

# --- Demo web app (apps/web) -------------------------------------------------
NEXT_PUBLIC_QAV_API_URL=http://localhost:8787
